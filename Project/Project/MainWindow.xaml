<Window x:Class="Project.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CAD Drawing Application"
        Height="600" Width="1000"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Toolbar -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="50" Background="LightGray">
            <Button Content="Line" Width="80" Margin="5" Click="LineButton_Click"/>
            <Button Content="Circle" Width="80" Margin="5" Click="CircleButton_Click"/>
            <Button Content="Arc" Width="80" Margin="5" Click="ArcButton_Click"/>
            <Button Content="Move" Width="80" Margin="5" Command="{Binding MoveCommand}"/>
            <Button Content="Trim" Width="80" Margin="5" Command="{Binding TrimCommand}"/>
            <Button Content="Extend" Width="80" Margin="5" Command="{Binding ExtendCommand}"/>
            <Button Content="Delete" Width="80" Margin="5" Command="{Binding DeleteCommand}"/>
            <Button Content="Save" Width="80" Margin="5" Command="{Binding SaveCommand}"/>
            <Button Content="Open" Width="80" Margin="5" Command="{Binding OpenCommand}"/>
            <Button Content="Delete All" Width="90" Margin="5" Command="{Binding DeleteAllCommand}"/>
        </StackPanel>

        <!-- Status Bar -->
        <Border DockPanel.Dock="Bottom" Height="45" Background="#3C3C3C">
            <StackPanel Orientation="Horizontal" Margin="10" VerticalAlignment="Center">
                <TextBlock Text="Prompt :" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Prompt}" Foreground="Yellow" FontSize="16" Margin="10,0,30,0"/>
                <TextBlock Text="Command :" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                <TextBox x:Name="CommandBox" Width="450" Height="28" Margin="10,0,0,0"
                         VerticalContentAlignment="Center" FontSize="16"
                         KeyDown="CommandBox_KeyDown"/>
                <TextBlock Text="   X:" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                <TextBlock x:Name="XCoordinate" Text="0" Foreground="Lime" FontSize="16" Margin="5,0"/>
                <TextBlock Text="Y:" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                <TextBlock x:Name="YCoordinate" Text="0" Foreground="Lime" FontSize="16" Margin="5,0"/>
            </StackPanel>
        </Border>

        <!-- Drawing Canvas -->
        <Border Margin="5" BorderBrush="Gray" BorderThickness="2">
            <Grid>
                <Canvas x:Name="canvas" Background="Black"
                        MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                        MouseMove="Canvas_MouseMove"
                        MouseLeftButtonUp="Canvas_MouseLeftButtonUp"/>
            </Grid>
        </Border>
    </DockPanel>
</Window>